<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_landed_cost_form_summary_intc" model="ir.ui.view">
        <field name="name">stock.landed.cost.form.summary.intc</field>
        <field name="model">stock.landed.cost</field>
        <field name="inherit_id" ref="stock_landed_costs.view_stock_landed_cost_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='valuation_adjustments']" position="after">
                <page string="Récapitulatif" name="summary_intc">
                    <field name="summary_html" nolabel="1"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
